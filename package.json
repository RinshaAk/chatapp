{
  "name": "pulsechat-platform",
  "version": "1.0.0",
  "private": true,
  "description": "Full-Stack Real-Time Messaging & Calling Platform",
  "workspaces": [
    "shared",
    "server",
    "client"
  ],
  "scripts": {
    "dev:server": "npm --prefix server run dev",
    "dev:client": "npm --prefix client run dev",
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "build:shared": "npm --prefix shared run build",
    "build:server": "npm --prefix server run build",
    "build:client": "npm --prefix client run build",
    "build": "npm run build:shared && npm run build:server",
    "start": "npm run start:server",
    "start:server": "npm --prefix server start",
    "start:client": "npm --prefix client start",
    "seed": "npm --prefix server run seed"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
